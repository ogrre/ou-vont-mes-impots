{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "app/Services/Api",
            "app/Services/Rap",
            "app/Support"
        ]
    },
    "testFramework": "phpunit",
    "phpUnit": {
        "configDir": "."
    },
    "threads": "max",
    "timeout": 30,
    "minMsi": 70,
    "minCoveredMsi": 70,
    "mutators": {
        // Les casts défensifs de données externes ne constituent pas de la
        // logique métier et génèrent surtout des mutants équivalents.
        "global-ignore": ["CastArray", "CastBool", "CastInt", "CastString"]
    },
    "logs": {
        "text": "storage/logs/infection.log",
        "summary": "storage/logs/infection-summary.log"
    }
}
